{
  "name": "@quaedra/verdict",
  "version": "0.1.0",
  "description": "A programming language where decisions are the branches: typed, exhaustive decisions that escalate across builtin → Nodd → Jet. Also a TypeScript library.",
  "keywords": [
    "verdict",
    "decision",
    "decisions",
    "classification",
    "programming-language",
    "dsl",
    "typescript",
    "exhaustive",
    "pattern-matching",
    "calibration",
    "model-cascade",
    "llm",
    "jet",
    "nodd",
    "quaedra"
  ],
  "homepage": "https://quaedra.com/verdict",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quaedra/verdict.git"
  },
  "bugs": {
    "url": "https://github.com/quaedra/verdict/issues"
  },
  "author": "Quaedra Research",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "verdict": "dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./node": "./dist/src/node.js"
  },
  "files": [
    "dist/src",
    "docs/LANGUAGE.md",
    "docs/SPEC.md",
    "editors",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --import tsx --test tests/*.test.ts && npm run typecheck",
    "verdict": "tsx src/cli.ts",
    "demo": "tsx examples/demo.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@nodd/node": ">=0.2",
    "tsx": ">=4"
  },
  "peerDependenciesMeta": {
    "@nodd/node": {
      "optional": true
    },
    "tsx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
